      "title": {
        "bo": "༄༅། །བཟང་སྤྱོད་སྨོན་ལམ་སོགས་ཀྱི་ཚོགས་འདོན་ཕྱོགས་བསྒྲིགས།"
      },
      "span": {
        "start": 0,
        "end": 17960
      },
      "subsections": [
        {
          "title": {
            "bo": "༄༅། །དཔལ་ལྡན་འབྲུག་པའི་ཉམས་བཞེས་སྐྱབས་འགྲོ་མ་ནམ་བཞི་སྐོར།"
          },
          "span": {
            "start": 0,
            "end": 1070
          }
        },
        {
          "title": {
            "bo": "༄༅། ༧རྒྱལ་བ་ཡིད་བཞིན་ནོར་བུའི་ཞབས་བརྟན་བཞུགས་སོ།།"
          },
          "span": {
            "start": 1070,
            "end": 1216
          }
        },
        {
          "title": {
            "bo": "༄༅། འབྲི་གུང་༧སྐྱབས་མགོན་ཉི་ཟླ་གཟུང་གི་ཞབས་བརྟན་བཞུགས་སོ།།"
          },
          "span": {
            "start": 1216,
            "end": 1373
          }
        },
        {
          "title": {
            "bo": "༄༅། དཔལ་༧རྒྱལ་དབང་འབྲུག་པ་བཅུ་གཉིས་པའི་ཞབས་བརྟན་བཞུགས་སོ།།"
          },
          "span": {
            "start": 1373,
            "end": 1547
          }
        },
        {
          "title": {
            "bo": "༄༅། གོང་མ་ཁྲི་ཆེན་རིན་པོ་ཆེའི་ཞབས་བརྟན་བཞུགས་སོ།།"
          },
          "span": {
            "start": 1547,
            "end": 1843
          }
        },
        {
          "title": {
            "bo": "འཕགས་པ་བཟང་པོ་སྤྱོད་པའི་སྨོན་ལམ་གྱི་རྒྱལ་པོ།"
          },
          "span": {
            "start": 1843,
            "end": 11247
          }
        },
        {
          "title": {
            "bo": "༄༅། །མར་མེ་སྨོན་ལམ་གྱི་དབུ་ཕྱོགས་བྷི་ཧ་ར།།"
          },
          "span": {
